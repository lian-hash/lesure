<view class="container data-v-01ca94c8"><block wx:if="{{loading}}"><loading-skeleton vue-id="0e26bf40-1" type="list" count="{{2}}" class="data-v-01ca94c8" bind:__l="__l"></loading-skeleton></block><block wx:if="{{order}}"><block class="data-v-01ca94c8"><view class="status-hero data-v-01ca94c8"><view class="row-between data-v-01ca94c8"><view class="sh-left data-v-01ca94c8"><view class="sh-status data-v-01ca94c8">{{$root.m0}}</view><view class="sh-tip data-v-01ca94c8">{{statusTip}}</view></view><view class="sh-emoji data-v-01ca94c8">{{statusEmoji}}</view></view></view><view class="card data-v-01ca94c8"><view class="section-title data-v-01ca94c8">订单信息</view><view class="row-between info-row data-v-01ca94c8"><text class="sub data-v-01ca94c8">订单号</text><text class="info-value data-v-01ca94c8">{{order.orderId}}</text></view><view class="row-between info-row data-v-01ca94c8"><text class="sub data-v-01ca94c8">订单金额</text><view class="info-amount data-v-01ca94c8"><text class="ia-symbol data-v-01ca94c8">¥</text><text class="ia-num data-v-01ca94c8">{{$root.m1}}</text></view></view><view class="row-between info-row data-v-01ca94c8"><text class="sub data-v-01ca94c8">支付状态</text><view class="{{['data-v-01ca94c8',$root.m2]}}">{{order.payStatus}}</view></view><view class="divider data-v-01ca94c8"></view><view class="row-between info-row data-v-01ca94c8"><text class="sub data-v-01ca94c8">使用日期</text><text class="info-value data-v-01ca94c8">{{order.useDate}}</text></view><view class="row-between info-row data-v-01ca94c8"><text class="sub data-v-01ca94c8">租赁份数</text><text class="info-value data-v-01ca94c8">{{order.quantity+" 份"}}</text></view><view class="row-between info-row data-v-01ca94c8"><text class="sub data-v-01ca94c8">下单时间</text><text class="info-value data-v-01ca94c8">{{$root.m3}}</text></view></view><view class="card data-v-01ca94c8"><view class="section-title data-v-01ca94c8">联系人</view><view class="row-between info-row data-v-01ca94c8"><text class="sub data-v-01ca94c8">姓名</text><text class="info-value data-v-01ca94c8">{{order.contactName||'-'}}</text></view><view class="row-between info-row data-v-01ca94c8"><text class="sub data-v-01ca94c8">手机号</text><text class="info-value data-v-01ca94c8">{{order.contactPhone||'-'}}</text></view></view><block wx:if="{{$root.g0>0}}"><view class="card data-v-01ca94c8"><view class="section-title data-v-01ca94c8">状态进度</view><order-timeline vue-id="0e26bf40-2" steps="{{steps}}" current-index="{{currentIndex}}" class="data-v-01ca94c8" bind:__l="__l"></order-timeline></view></block><block wx:if="{{order.orderStatus==='已完成'}}"><button class="btn-primary review-btn data-v-01ca94c8" hover-class="btn-hover" data-event-opts="{{[['tap',[['onReview',['$event']]]]]}}" bindtap="__e">提交评价</button></block></block></block><block wx:if="{{!loading&&!order}}"><empty-state vue-id="0e26bf40-3" emoji="📦" title="订单不存在" desc="订单可能已取消或已归档" btn-text="返回订单列表" data-event-opts="{{[['^action',[['onBackList']]]]}}" bind:action="__e" class="data-v-01ca94c8" bind:__l="__l"></empty-state></block></view>
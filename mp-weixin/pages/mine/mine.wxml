<view class="container data-v-2de38b1b"><view class="profile-hero data-v-2de38b1b"><view class="avatar data-v-2de38b1b">{{loggedIn?'🏕️':'👤'}}</view><view class="profile-main data-v-2de38b1b"><view class="profile-name data-v-2de38b1b">{{loggedIn?nickname||'微信用户':'未登录'}}</view><view class="profile-sub data-v-2de38b1b"><block wx:if="{{loggedIn}}"><text class="chip chip-glass data-v-2de38b1b">{{role||'C端'}}</text></block><block wx:else><text class="profile-tip data-v-2de38b1b">登录后即可下单与评价</text></block></view></view></view><view class="card data-v-2de38b1b"><view class="section-title data-v-2de38b1b">账户信息</view><block wx:if="{{loggedIn}}"><block class="data-v-2de38b1b"><view class="row-between info-row data-v-2de38b1b"><text class="sub data-v-2de38b1b">昵称</text><text class="info-value data-v-2de38b1b">{{nickname||'微信用户'}}</text></view><view class="row-between info-row data-v-2de38b1b"><text class="sub data-v-2de38b1b">角色</text><text class="info-value data-v-2de38b1b">{{role||'-'}}</text></view><block wx:if="{{phone}}"><view class="row-between info-row data-v-2de38b1b"><text class="sub data-v-2de38b1b">手机号</text><text class="info-value data-v-2de38b1b">{{phone}}</text></view></block></block></block><block wx:else><view class="sub login-tip data-v-2de38b1b">当前未登录，部分功能不可用</view></block></view><view class="card data-v-2de38b1b"><view class="section-title data-v-2de38b1b">快捷入口</view><view class="quick-row data-v-2de38b1b"><view class="quick-item data-v-2de38b1b" hover-class="btn-hover" data-event-opts="{{[['tap',[['onGoOrders',['$event']]]]]}}" bindtap="__e"><text class="quick-emoji data-v-2de38b1b">🧾</text><text class="quick-text data-v-2de38b1b">我的订单</text></view><view class="quick-item data-v-2de38b1b" hover-class="btn-hover" data-event-opts="{{[['tap',[['onGoHome',['$event']]]]]}}" bindtap="__e"><text class="quick-emoji data-v-2de38b1b">🎒</text><text class="quick-text data-v-2de38b1b">浏览套餐</text></view><view class="quick-item data-v-2de38b1b" hover-class="btn-hover" data-event-opts="{{[['tap',[['onGoHome',['$event']]]]]}}" bindtap="__e"><text class="quick-emoji data-v-2de38b1b">🏕️</text><text class="quick-text data-v-2de38b1b">营地场地</text></view></view></view><block wx:if="{{!loggedIn}}"><button class="btn-primary login-btn data-v-2de38b1b" hover-class="btn-hover" data-event-opts="{{[['tap',[['onLogin',['$event']]]]]}}" bindtap="__e">微信授权登录</button></block></view>
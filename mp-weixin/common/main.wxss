page{--primary:#2e7d32;--primary-light:#4caf50;--primary-lighter:#66bb6a;--accent:#ff8f3f;--bg:#f5f7f4;--card:#fff;--text:#333;--text-sub:#666;--muted:#999;--border:#eef0ee;--chip-bg:#e8f5e9;--shadow-card:0 8rpx 24rpx rgba(46,125,50,0.08);--shadow-hover:0 12rpx 32rpx rgba(46,125,50,0.14);--radius-card:20rpx;--radius-btn:16rpx;--radius-chip:8rpx;--radius-img:16rpx;background-color:var(--bg);color:var(--text);font-size:28rpx;font-family:-apple-system,BlinkMacSystemFont,Helvetica Neue,Helvetica,sans-serif}.container{padding:24rpx;box-sizing:border-box;min-height:100vh}.row-between{display:flex;align-items:center;justify-content:space-between}.card{background:var(--card);border-radius:var(--radius-card);padding:28rpx;margin-bottom:20rpx;box-shadow:var(--shadow-card)}.card-hover{box-shadow:var(--shadow-hover)}.title{font-size:32rpx;font-weight:700;color:var(--text)}.section-title{position:relative;font-size:30rpx;font-weight:700;color:var(--text);padding-left:18rpx;margin:24rpx 0 20rpx}.section-title::before{content:"";position:absolute;left:0;top:50%;transform:translateY(-50%);width:6rpx;height:28rpx;border-radius:3rpx;background:linear-gradient(180deg,var(--primary-lighter),var(--primary))}.muted{color:var(--muted);font-size:24rpx}.sub{color:var(--text-sub);font-size:26rpx}.price{color:var(--accent);font-weight:700}.divider{height:1rpx;background:var(--border);margin:20rpx 0}.chip{display:inline-block;padding:4rpx 14rpx;margin-right:12rpx;border-radius:var(--radius-chip);font-size:22rpx;line-height:34rpx;background:#f1f3f0;color:var(--text-sub)}.chip-green{background:var(--chip-bg);color:var(--primary)}.chip-orange{background:#fff3e0;color:var(--accent)}.chip-glass{background:hsla(0,0%,100%,.92);color:var(--primary);font-weight:600}.badge{display:inline-block;padding:6rpx 18rpx;border-radius:999rpx;font-size:22rpx;line-height:32rpx;background:#f5f5f5;color:var(--muted)}.badge-orange{background:#fff3e0;color:#ff8f3f}.badge-blue{background:#e3f2fd;color:#1976d2}.badge-green{background:#e8f5e9;color:#2e7d32}.badge-primary{background:#e8f5e9;color:#2e7d32}.badge-gray{background:#f5f5f5;color:#999}.btn-primary{background:linear-gradient(135deg,var(--primary-light),var(--primary));color:#fff;border-radius:var(--radius-btn);height:88rpx;line-height:88rpx;font-size:30rpx;font-weight:600;box-shadow:0 8rpx 20rpx rgba(46,125,50,.18)}button.btn-primary::after{border:none}.btn-primary[disabled]{background:#cfcfcf;color:#fff;box-shadow:none}.btn-ghost{background:#fff;color:var(--primary);border:2rpx solid var(--primary);border-radius:var(--radius-btn);height:88rpx;line-height:88rpx;font-size:30rpx;font-weight:600}.btn-hover{opacity:.88;transform:scale(.985)}.skeleton{background:linear-gradient(90deg,#edeff0 25%,#f7f9f8 37%,#edeff0 63%);background-size:400% 100%;border-radius:12rpx;animation:sk-shimmer 1.4s ease-in-out infinite}@keyframes sk-shimmer{0%{background-position:100% 50%}100%{background-position:0 50%}}.empty-state{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:80rpx 24rpx}.empty-illus{width:160rpx;height:160rpx;border-radius:50%;background:linear-gradient(135deg,#e8f5e9,#c8e6c9);display:flex;align-items:center;justify-content:center;font-size:72rpx;box-shadow:0 8rpx 24rpx rgba(46,125,50,.1);margin-bottom:28rpx}.empty-title{font-size:30rpx;font-weight:600;color:var(--text-sub)}.empty-desc{margin-top:12rpx;font-size:24rpx;color:var(--muted)}.empty-btn{margin-top:32rpx;padding:0 40rpx;height:72rpx;line-height:72rpx;border-radius:36rpx;background:var(--primary);color:#fff;font-size:26rpx}page::after{position:fixed;content:'';left:-1000px;top:-1000px;-webkit-animation:shadow-preload .1s;-webkit-animation-delay:3s;animation:shadow-preload .1s;animation-delay:3s}@-webkit-keyframes shadow-preload{0%{background-image:url(https://cdn1.dcloud.net.cn/img/shadow-grey.png)}100%{background-image:url(https://cdn1.dcloud.net.cn/img/shadow-grey.png)}}@keyframes shadow-preload{0%{background-image:url(https://cdn1.dcloud.net.cn/img/shadow-grey.png)}100%{background-image:url(https://cdn1.dcloud.net.cn/img/shadow-grey.png)}}
<view class="site-card data-v-f77bf208" hover-class="site-card-hover" hover-stay-time="{{80}}" data-event-opts="{{[['tap',[['onTap',['$event']]]]]}}" bindtap="__e"><view class="site-icon data-v-f77bf208">{{site.availableStatus==='可用'?'🏕️':'🚧'}}</view><view class="site-main data-v-f77bf208"><view class="site-name data-v-f77bf208">{{site.name}}</view><view class="site-addr data-v-f77bf208">{{site.address}}</view><view class="site-meta data-v-f77bf208"><text class="site-meta-item data-v-f77bf208">{{"容量 "+site.capacity+" 人"}}</text><block wx:if="{{site.partner}}"><text class="site-meta-item data-v-f77bf208">{{"合作方 "+site.partner}}</text></block></view></view><view class="{{['data-v-f77bf208',statusClass]}}">{{site.availableStatus}}</view></view>